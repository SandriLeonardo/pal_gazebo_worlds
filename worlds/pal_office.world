    </include>
    <include>
      <name>shelf_E3</name>
      <uri>model://shelf</uri>
      <pose>5 4.85 0.05 0 0 3.14</pose>
      <scale>1.5 1 1</scale>
    </include>

    <include>
      <name>shelf_W1</name>
      <uri>model://shelf</uri>
      <pose>-6 -4.85 0.05 0 0 0</pose>
      <scale>1.5 1 1</scale>
    </include>

    <include>
      <name>shelf_Mid_sx1</name>
      <uri>model://shelf</uri>
      <pose>3 1 0.05 0 0 1.57</pose>
      <scale>3.5 1 1</scale>
    </include>

    <include>
      <name>shelf_Mid_dx1</name>
      <uri>model://shelf</uri>
      <pose>-3 1 0.05 0 0 1.57</pose>
      <scale>3.5 1 1</scale>
    </include>

    <include>
      <name>shelf_Mid_sx2</name>
      <uri>model://shelf</uri>
      <pose>3 -1 0.05 0 0 1.57</pose>
      <scale>3.5 1 1</scale>
    </include>

    <include>
      <name>shelf_Mid_dx2</name>
      <uri>model://shelf</uri>
      <pose>-3 -1 0.05 0 0 1.57</pose>
      <scale>3.5 1 1</scale>
    </include>

    <!-- Person models with AprilTags -->
    <include>
      <name>staff_leonardo</name>
      <uri>model://staff_leonardo</uri>
      <pose>2.5 0.0 0.0 0 0 -1.540470</pose>
    </include>

    <include>
      <name>staff_lorenzo</name>
      <uri>model://staff_lorenzo</uri>
      <pose>6.722341 -3.300510 0.0 -0.000001 0.000001 -1.540470</pose>
    </include>

    <include>
      <name>staff_federico</name>
      <uri>model://staff_federico</uri>
